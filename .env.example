# Environment Configuration for Viral Hindi YouTube Automation

# Web Dashboard Port
PORT=3000

# AI Provider Credentials (Gemini API or OpenAI API)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Stock Media API Keys (Pexels / Pixabay)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# YouTube Data API Credentials
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Automation Settings
LANGUAGE=hindi
SHORTS_PER_DAY=3
LONG_VIDEOS_PER_WEEK=3
LONG_VIDEO_DAYS=Tuesday,Thursday,Sunday
